ARG PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.12-slim
FROM ${PYTHON_IMAGE}
WORKDIR /app
COPY backend/requirements.lock ./requirements.lock
COPY wheels /wheels
RUN pip install --no-index --find-links=/wheels -r requirements.lock && pip check && rm -rf /wheels
COPY backend/ ./
COPY web ./app/static
COPY BUILD-MANIFEST.json ./BUILD-MANIFEST.json
RUN useradd -m -u 10001 huoke
USER huoke
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
